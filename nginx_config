# ============================================================
# Nginx Virtual Host Configuration - Surya Tour Trans
# Protected against IP bypass scans
# ============================================================

# 1. Catch-all default server for Port 80 (HTTP)
# Returns HTTP 444 (Connection Closed without response) for direct IP access
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

# 2. Catch-all default server for Port 443 (HTTPS)
# Establishes TLS handshake and then drops connection with 444
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/mafinatrans.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mafinatrans.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 444;
}

# 3. Main Virtual Host for mafinatrans.com (HTTPS)
server {
    server_name mafinatrans.com www.mafinatrans.com;
    root /var/www/bus-pariwisata;
    index index.html index.htm index.php;

    # HTTP Security Headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self' https: http: 'unsafe-inline' 'unsafe-eval' data:; img-src 'self' data: https: http:; font-src 'self' https: http: data:; connect-src 'self' https: http:;" always;

    # Support React SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|otf)$ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
        access_log off;
        try_files $uri =404;
    }

    # Enable Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # Handle PHP scripts using PHP-FPM
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Deny access to sensitive folders
    location ^~ /config {
        deny all;
        return 404;
    }
    location ^~ /database {
        deny all;
        return 404;
    }

    # Deny access to sensitive files
    location ~* \.(env|sql|bak|zip|git|gitignore|htaccess|config)$ {
        deny all;
        return 404;
    }

    # Prevent PHP execution in the images/ upload folder
    location ~* ^/images/.*\.(php|phtml|phar|pl|py|sh|cgi)$ {
        deny all;
        return 404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/mafinatrans.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/mafinatrans.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

# 4. HTTP to HTTPS redirect for mafinatrans.com
server {
    listen 80;
    listen [::]:80;
    server_name mafinatrans.com www.mafinatrans.com;
    return 301 https://$host$request_uri;
}